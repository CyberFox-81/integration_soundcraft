index 0000000..912f328
--- /dev/null
+++ b/apps/soundcraft-web/src/host.rs
@@ -0,0 +1,308 @@
+//! The `postMessage` bridge to a same-origin parent page (`?host=parent`), for pages that embed
+//! SoundCraft in an `<iframe>` (such as a Nextcloud app). Paths are the parent's (absolute,
+//! `/Music/Song.wav`): SoundCraft's file prompts, Save and Bounce use them through the engine's
+//! in-memory files (`soundcraft_engine::fs`). Messages are plain objects with a `type`:
+//!
+//! - `soundcraft:ready` (to the parent): `{ version }`, the app is listening; send a file now.
+//! - `soundcraft:open` (from the parent): `{ name, path, bytes | blob }`. A session (`.scraft`)
+//!   opens with its audio, which SoundCraft asks for with `need`. An audio file opens as a new
+//!   session of the same name with the file on a track; Save stores that session next to it.
+//! - `soundcraft:need` (to the parent): `{ paths }`, the audio files an opened session uses.
+//! - `soundcraft:file` (from the parent): `{ path, bytes | blob }` one of them, or
+//!   `{ path, error }` when it can't be read (the session opens with that file missing).
+//! - `soundcraft:save` (to the parent): `{ name, bytes, quiet }` for every file SoundCraft
+//!   writes, `name` being its path: the session, the audio files saved with it in its
+//!   `Audio Files` folder (`quiet`: stored without a notice), bounces and exports. The parent
+//!   stores them, creating folders as needed, and reports failures itself.
+//! - `soundcraft:dirty` (to the parent): `{ dirty }` whenever unsaved changes appear or go away.
+//! - `soundcraft:failed` (to the parent): `{ error }` when the app couldn't start.
+//!
+//! Audio files dropped on the window are imported onto new tracks. Only the parent window on the
+//! page's own origin is heard or answered. In host mode the page starts with an empty session
+//! instead of the demo, and the parent guards leaving the page.
+
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeSet, VecDeque};
+use std::path::Path;
+use std::rc::Rc;
+
+use serde_json::json;
+use soundcraft_engine::fs;
+use soundcraft_ui_egui::SoundApp;
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::JsValue;
+use wasm_bindgen::closure::Closure;
+
+/// Where dropped files wait in memory while they are imported.
+const DROPPED: &str = "/.soundcraft-dropped";
+
+/// What arrived from the parent or the window, handled between frames.
+enum Incoming {
+    Open { name: String, path: String, bytes: Vec<u8> },
+    File { path: String, bytes: Option<Vec<u8>> },
+    Dropped { name: String, bytes: Vec<u8> },
+}
+
+/// An opened session waiting for its audio.
+struct Pending {
+    path: String,
+    text: String,
+    waiting: BTreeSet<String>,
+}
+
+#[derive(Clone)]
+pub struct Bridge {
+    window: web_sys::Window,
+    parent: web_sys::Window,
+    origin: String,
+    incoming: Rc<RefCell<VecDeque<Incoming>>>,
+    pending: Rc<RefCell<Option<Pending>>>,
+    /// The unsaved-changes state last reported to the parent.
+    reported: Rc<Cell<Option<bool>>>,
+}
+
+impl Bridge {
+    /// `None` when the page isn't framed (there is no parent to talk to).
+    pub fn new() -> Option<Self> {
+        let window = web_sys::window()?;
+        let parent = window.parent().ok().flatten()?;
+        if js_sys::Object::is(&parent, &window) {
+            return None;
+        }
+        let origin = window.location().origin().ok()?;
+        Some(Self { window, parent, origin, incoming: Rc::default(), pending: Rc::default(), reported: Rc::default() })
+    }
+
+    /// Hand what the engine writes to the parent, and hear files from it.
+    pub fn connect(&self, ctx: egui::Context) {
+        self.listen(ctx);
+        let bridge = self.clone();
+        fs::set_on_write(move |path: &str, bytes: &[u8]| {
+            if let Err(e) = bridge.post_save(path, bytes) {
+                log::error!("couldn't hand {path} to the page: {e}");
+            }
+        });
+    }
+
+    pub fn post_ready(&self) {
+        self.send(&[("type", "soundcraft:ready".into()), ("version", env!("CARGO_PKG_VERSION").into())]);
+    }
+
+    pub fn post_failed(&self, error: &str) {
+        self.send(&[("type", "soundcraft:failed".into()), ("error", error.into())]);
+    }
+
+    /// Files dropped on the window (read asynchronously, imported between frames).
+    pub fn take_dropped(&self, ctx: &egui::Context) {
+        let dropped = ctx.input_mut(|i| std::mem::take(&mut i.raw.dropped_files));
+        for f in dropped {
+            let incoming = self.incoming.clone();
+            let ctx = ctx.clone();
+            wasm_bindgen_futures::spawn_local(async move {
+                let name = f.path().file_name().map(|n| n.to_string_lossy().to_string()).unwrap_or_else(|| "Dropped.wav".into());
+                match f.bytes_async().await {
+                    Ok(bytes) => {
+                        incoming.borrow_mut().push_back(Incoming::Dropped { name, bytes });
+                        ctx.request_repaint();
+                    }
+                    Err(e) => log::error!("couldn't read dropped file {name}: {e}"),
+                }
+            });
+        }
+    }
+
+    /// Before each frame: open what arrived, and tell the parent when unsaved changes appear or
+    /// go away.
+    pub fn sync(&self, app: &mut SoundApp) {
+        loop {
+            let next = self.incoming.borrow_mut().pop_front();
+            let Some(next) = next else { break };
+            let result = match next {
+                Incoming::Open { name, path, bytes } => self.open(app, &name, &path, bytes),
+                Incoming::File { path, bytes } => self.arrived(app, &path, bytes),
+                Incoming::Dropped { name, bytes } => import_dropped(app, &name, bytes),
+            };
+            if let Err(e) = result {
+                log::error!("{e}");
+                app.ui.status = e;
+            }
+        }
+        let dirty = app.engine.is_dirty();
+        if self.reported.get() != Some(dirty) && self.send(&[("type", "soundcraft:dirty".into()), ("dirty", dirty.into())]) {
+            self.reported.set(Some(dirty));
+        }
+    }
+
+    fn open(&self, app: &mut SoundApp, name: &str, path: &str, bytes: Vec<u8>) -> Result<(), String> {
+        let path = if path.starts_with('/') { path.to_string() } else { format!("/{name}") };
+        if has_extension(name, soundcraft_model::SESSION_EXTENSION) {
+            self.begin_session(app, &path, bytes)
+        } else {
+            open_audio(app, name, &path, bytes)
+        }
+    }
+
+    /// A session: ask the parent for its audio first.
+    fn begin_session(&self, app: &mut SoundApp, path: &str, bytes: Vec<u8>) -> Result<(), String> {
+        let text = String::from_utf8(bytes).map_err(|_| format!("{path} is not a SoundCraft session"))?;
+        let session = soundcraft_model::Session::from_json(&text).map_err(|e| format!("{path}: {e}"))?;
+        let dir = Path::new(path).parent().unwrap_or_else(|| Path::new("/"));
+        let waiting: BTreeSet<String> = session
+            .sources
+            .iter()
+            .map(|s| if Path::new(&s.path).is_absolute() { s.path.clone() } else { dir.join(&s.path).to_string_lossy().into_owned() })
+            .collect();
+        if waiting.is_empty() {
+            return finish_session(app, path, text);
+        }
+        let paths = js_sys::Array::new();
+        for p in &waiting {
+            paths.push(&JsValue::from_str(p));
+        }
+        self.send(&[("type", "soundcraft:need".into()), ("paths", paths.into())]);
+        *self.pending.borrow_mut() = Some(Pending { path: path.to_string(), text, waiting });
+        app.ui.status = "Loading the session's audio…".into();
+        Ok(())
+    }
+
+    /// One of the session's audio files (or the news that it can't be read).
+    fn arrived(&self, app: &mut SoundApp, path: &str, bytes: Option<Vec<u8>>) -> Result<(), String> {
+        let mut pending = self.pending.borrow_mut();
+        let Some(p) = pending.as_mut() else { return Ok(()) };
+        if !p.waiting.remove(path) {
+            return Ok(());
+        }
+        if let Some(bytes) = bytes {
+            fs::put(path, bytes);
+        }
+        if !p.waiting.is_empty() {
+            return Ok(());
+        }
+        let Some(done) = pending.take() else { return Ok(()) };
+        drop(pending);
+        finish_session(app, &done.path, done.text)
+    }
+
+    fn post_save(&self, path: &str, bytes: &[u8]) -> Result<(), String> {
+        // Audio saved with a session (in its `Audio Files` folder) is part of saving it.
+        let quiet = Path::new(path).parent().and_then(Path::file_name).is_some_and(|d| d == "Audio Files");
+        let buffer = js_sys::Uint8Array::from(bytes).buffer();
+        let message =
+            message(&[("type", "soundcraft:save".into()), ("name", path.into()), ("bytes", buffer.clone().into()), ("quiet", quiet.into())])
+                .ok_or_else(|| "couldn't build the message".to_string())?;
+        self.parent
+            .post_message_with_transfer(&message, &self.origin, &js_sys::Array::of1(&buffer))
+            .map_err(|e| e.as_string().unwrap_or_else(|| format!("{e:?}")))
+    }
+
+    fn listen(&self, ctx: egui::Context) {
+        let parent = self.parent.clone();
+        let origin = self.origin.clone();
+        let incoming = self.incoming.clone();
+        let on_message = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |event: web_sys::MessageEvent| {
+            if event.origin() != origin || !event.source().is_some_and(|s| js_sys::Object::is(&s, &parent)) {
+                return;
+            }
+            let data = event.data();
+            let kind = string(&data, "type");
+            let path = string(&data, "path").unwrap_or_default();
+            let incoming = incoming.clone();
+            let ctx = ctx.clone();
+            match kind.as_deref() {
+                Some("soundcraft:open") => {
+                    let name = string(&data, "name").filter(|n| !n.trim().is_empty()).unwrap_or_else(|| "Audio.wav".to_string());
+                    wasm_bindgen_futures::spawn_local(async move {
+                        match bytes(&data).await {
+                            Some(bytes) => incoming.borrow_mut().push_back(Incoming::Open { name, path, bytes }),
+                            None => log::error!("couldn't read {name} from the page"),
+                        }
+                        ctx.request_repaint();
+                    });
+                }
+                Some("soundcraft:file") => {
+                    wasm_bindgen_futures::spawn_local(async move {
+                        let bytes = bytes(&data).await;
+                        if bytes.is_none() {
+                            log::warn!("{path}: {}", string(&data, "error").unwrap_or_else(|| "not available".into()));
+                        }
+                        incoming.borrow_mut().push_back(Incoming::File { path, bytes });
+                        ctx.request_repaint();
+                    });
+                }
+                _ => {}
+            }
+        });
+        if self.window.add_event_listener_with_callback("message", on_message.as_ref().unchecked_ref()).is_ok() {
+            // The listener lives as long as the page.
+            on_message.forget();
+        }
+    }
+
+    /// Post a message to the parent; false if it couldn't be sent.
+    fn send(&self, fields: &[(&str, JsValue)]) -> bool {
+        message(fields).is_some_and(|m| self.parent.post_message(&m, &self.origin).is_ok())
+    }
+}
+
+/// An audio file opens as a new session named after it, with the file on a track. Save stores
+/// the session next to the file (`Song.wav` → `Song.scraft`, its audio in `Audio Files`).
+fn open_audio(app: &mut SoundApp, name: &str, path: &str, bytes: Vec<u8>) -> Result<(), String> {
+    let ext = Path::new(name).extension().and_then(|e| e.to_str()).map(str::to_ascii_lowercase);
+    let info = soundcraft_audio_io::probe(&bytes, ext.as_deref()).map_err(|e| format!("{name}: {e}"))?;
+    let rate = Some(info.sample_rate).filter(|r| soundcraft_time::SampleRate::COMMON.contains(r)).unwrap_or(48_000);
+    let stem = Path::new(name).file_stem().and_then(|s| s.to_str()).unwrap_or("Untitled").to_string();
+    app.run("session.new", json!({"name": stem, "sample_rate": rate}))?;
+    fs::put(path, bytes);
+    let imported = app.run("file.import_audio", json!({"path": path}));
+    fs::remove(path);
+    imported?;
+    let dir = Path::new(path).parent().unwrap_or_else(|| Path::new("/"));
+    app.engine.path = Some(dir.join(format!("{stem}.{}", soundcraft_model::SESSION_EXTENSION)).to_string_lossy().into_owned());
+    app.engine.mark_clean();
+    Ok(())
+}
+
+fn finish_session(app: &mut SoundApp, path: &str, text: String) -> Result<(), String> {
+    fs::put(path, text.into_bytes());
+    app.ui.status.clear();
+    app.run("session.open", json!({"path": path})).map(drop)
+}
+
+/// A file dropped on the window: imported onto a new track at the start of the session.
+fn import_dropped(app: &mut SoundApp, name: &str, bytes: Vec<u8>) -> Result<(), String> {
+    let path = format!("{DROPPED}/{name}");
+    fs::put(&path, bytes);
+    let imported = app.run("file.import_audio", json!({"path": path}));
+    fs::remove(&path);
+    imported.map(drop)
+}
+
+fn has_extension(name: &str, ext: &str) -> bool {
+    Path::new(name).extension().is_some_and(|e| e.eq_ignore_ascii_case(ext))
+}
+
+fn message(fields: &[(&str, JsValue)]) -> Option<js_sys::Object> {
+    let m = js_sys::Object::new();
+    for (key, value) in fields {
+        js_sys::Reflect::set(&m, &JsValue::from_str(key), value).ok()?;
+    }
+    Some(m)
+}
+
+fn string(data: &JsValue, key: &str) -> Option<String> {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok()?.as_string()
+}
+
+/// `bytes` (an `ArrayBuffer` or `Uint8Array`) or `blob`.
+async fn bytes(data: &JsValue) -> Option<Vec<u8>> {
+    let bytes = js_sys::Reflect::get(data, &JsValue::from_str("bytes")).ok()?;
+    if let Some(array) = bytes.dyn_ref::<js_sys::Uint8Array>() {
+        return Some(array.to_vec());
+    }
+    if bytes.is_instance_of::<js_sys::ArrayBuffer>() {
+        return Some(js_sys::Uint8Array::new(&bytes).to_vec());
+    }
+    let blob = js_sys::Reflect::get(data, &JsValue::from_str("blob")).ok()?.dyn_into::<web_sys::Blob>().ok()?;
+    let buffer = wasm_bindgen_futures::JsFuture::from(blob.array_buffer()).await.ok()?;
+    Some(js_sys::Uint8Array::new(&buffer).to_vec())
+}
