diff --git a/crates/engine/src/fs.rs b/crates/engine/src/fs.rs
new file mode 100644
index 0000000..cea3505
--- /dev/null
+++ b/crates/engine/src/fs.rs
@@ -0,0 +1,242 @@
+//! File access for the engine's open, save, import and export commands.
+//!
+//! Native builds use the real file system. The browser (wasm32) has none: there, files live in
+//! memory, and only once a host page has asked for that with [`set_on_write`] (the web shell's
+//! `?host=parent` mode, for pages such as a Nextcloud app that frame SoundCraft). The host puts
+//! the files a session needs with [`put`] and is handed every file the engine writes, under the
+//! same path. Without a host, browser writes fail as they always have.
+
+use std::io;
+use std::path::Path;
+
+/// Read a whole file.
+pub fn read(path: impl AsRef<Path>) -> io::Result<Vec<u8>> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        memory::with(|s| s.read(path.as_ref()))
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::fs::read(path)
+    }
+}
+
+/// Read a whole UTF-8 text file.
+pub fn read_to_string(path: impl AsRef<Path>) -> io::Result<String> {
+    String::from_utf8(read(path)?).map_err(|err| io::Error::new(io::ErrorKind::InvalidData, err))
+}
+
+/// Write a whole file, replacing it.
+pub fn write(path: impl AsRef<Path>, bytes: impl AsRef<[u8]>) -> io::Result<()> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        let written = memory::with(|s| s.write(path.as_ref(), bytes.as_ref().to_vec()))?;
+        memory::notify(written);
+        Ok(())
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::fs::write(path, bytes)
+    }
+}
+
+/// Rename a file (used to replace a file in one step after writing a temporary one).
+pub fn rename(from: impl AsRef<Path>, to: impl AsRef<Path>) -> io::Result<()> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        let written = memory::with(|s| s.rename(from.as_ref(), to.as_ref()))?;
+        memory::notify(written);
+        Ok(())
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::fs::rename(from, to)
+    }
+}
+
+/// Create a folder and its parents.
+pub fn create_dir_all(path: impl AsRef<Path>) -> io::Result<()> {
+    #[cfg(target_arch = "wasm32")]
+    {
+        // Folders exist implicitly in memory; the host creates them as it stores files.
+        let _ = path;
+        memory::with(|s| s.writable()).map(|_| ())
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        std::fs::create_dir_all(path)
+    }
+}
+
+/// Whether a file (native: or folder) exists.
+pub fn exists(path: impl AsRef<Path>) -> bool {
+    #[cfg(target_arch = "wasm32")]
+    {
+        memory::with(|s| s.exists(path.as_ref()))
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        path.as_ref().exists()
+    }
+}
+
+/// Browser: a file the host provides (an opened session's audio, a file to import). Putting a
+/// file doesn't count as the engine writing it.
+#[cfg(target_arch = "wasm32")]
+pub fn put(path: impl AsRef<Path>, bytes: Vec<u8>) {
+    memory::with(|s| s.put(path.as_ref(), bytes));
+}
+
+/// Browser: forget a file put with [`put`] that is no longer needed.
+#[cfg(target_arch = "wasm32")]
+pub fn remove(path: impl AsRef<Path>) {
+    memory::with(|s| s.remove(path.as_ref()));
+}
+
+/// Browser: let the engine write files, handing each one (path, bytes) to `on_write` once it is
+/// complete. Temporary files (`*.tmp`) aren't handed over; renaming one is.
+#[cfg(target_arch = "wasm32")]
+pub fn set_on_write(on_write: impl Fn(&str, &[u8]) + 'static) {
+    memory::with(|s| s.on_write = Some(std::rc::Rc::new(on_write)));
+}
+
+/// The browser's in-memory files. Built everywhere so it is tested natively.
+#[cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+mod memory {
+    use std::cell::RefCell;
+    use std::collections::HashMap;
+    use std::io;
+    use std::path::{Component, Path};
+    use std::rc::Rc;
+
+    type OnWrite = Rc<dyn Fn(&str, &[u8])>;
+
+    /// A finished write for the host: called outside the store's borrow.
+    pub type Written = Option<(OnWrite, String, Rc<Vec<u8>>)>;
+
+    #[derive(Default)]
+    pub struct Store {
+        files: HashMap<String, Rc<Vec<u8>>>,
+        pub on_write: Option<OnWrite>,
+    }
+
+    thread_local! {
+        static STORE: RefCell<Store> = RefCell::new(Store::default());
+    }
+
+    pub fn with<T>(f: impl FnOnce(&mut Store) -> T) -> T {
+        STORE.with(|s| f(&mut s.borrow_mut()))
+    }
+
+    pub fn notify(written: Written) {
+        if let Some((on_write, path, bytes)) = written {
+            on_write(&path, &bytes);
+        }
+    }
+
+    /// `/a/./b/../c` → `/a/c`; relative paths stay relative.
+    pub fn key(path: &Path) -> String {
+        let mut parts: Vec<String> = Vec::new();
+        let mut absolute = false;
+        for c in path.components() {
+            match c {
+                Component::RootDir | Component::Prefix(_) => absolute = true,
+                Component::CurDir => {}
+                Component::ParentDir => {
+                    parts.pop();
+                }
+                Component::Normal(p) => parts.push(p.to_string_lossy().into_owned()),
+            }
+        }
+        let joined = parts.join("/");
+        if absolute { format!("/{joined}") } else { joined }
+    }
+
+    fn unsupported() -> io::Error {
+        io::Error::new(io::ErrorKind::Unsupported, "the browser has no file system")
+    }
+
+    fn is_temporary(key: &str) -> bool {
+        Path::new(key).extension().is_some_and(|e| e.eq_ignore_ascii_case("tmp"))
+    }
+
+    impl Store {
+        pub fn writable(&self) -> io::Result<OnWrite> {
+            self.on_write.clone().ok_or_else(unsupported)
+        }
+
+        pub fn read(&self, path: &Path) -> io::Result<Vec<u8>> {
+            let k = key(path);
+            self.files
+                .get(&k)
+                .map(|b| b.as_ref().clone())
+                .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, format!("{k} is not available in the browser")))
+        }
+
+        pub fn write(&mut self, path: &Path, bytes: Vec<u8>) -> io::Result<Written> {
+            let on_write = self.writable()?;
+            let k = key(path);
+            let bytes = Rc::new(bytes);
+            self.files.insert(k.clone(), bytes.clone());
+            Ok((!is_temporary(&k)).then_some((on_write, k, bytes)))
+        }
+
+        pub fn rename(&mut self, from: &Path, to: &Path) -> io::Result<Written> {
+            let on_write = self.writable()?;
+            let (from, to) = (key(from), key(to));
+            let bytes = self.files.remove(&from).ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, format!("{from} doesn't exist")))?;
+            self.files.insert(to.clone(), bytes.clone());
+            Ok((!is_temporary(&to)).then_some((on_write, to, bytes)))
+        }
+
+        pub fn exists(&self, path: &Path) -> bool {
+            self.files.contains_key(&key(path))
+        }
+
+        pub fn put(&mut self, path: &Path, bytes: Vec<u8>) {
+            self.files.insert(key(path), Rc::new(bytes));
+        }
+
+        pub fn remove(&mut self, path: &Path) {
+            self.files.remove(&key(path));
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+        use std::cell::RefCell;
+
+        #[test]
+        fn keys_are_normalized() {
+            assert_eq!(key(Path::new("/Music/./Audio Files/../Song.scraft")), "/Music/Song.scraft");
+            assert_eq!(key(&Path::new("/Music").join("Audio Files/a.wav")), "/Music/Audio Files/a.wav");
+            assert_eq!(key(Path::new("Audio Files/a.wav")), "Audio Files/a.wav");
+            assert_eq!(key(Path::new("/../..")), "/");
+        }
+
+        #[test]
+        fn writes_need_a_host() {
+            let mut s = Store::default();
+            assert_eq!(s.write(Path::new("/a.wav"), vec![1]).err().map(|e| e.kind()), Some(io::ErrorKind::Unsupported));
+            assert!(!s.exists(Path::new("/a.wav")));
+            s.put(Path::new("/b.wav"), vec![2]);
+            assert_eq!(s.read(Path::new("/b.wav")).ok(), Some(vec![2]));
+            assert_eq!(s.read(Path::new("/c.wav")).err().map(|e| e.kind()), Some(io::ErrorKind::NotFound));
+        }
+
+        #[test]
+        fn the_host_gets_finished_files_only() {
+            let got: Rc<RefCell<Vec<(String, Vec<u8>)>>> = Rc::default();
+            let mut s = Store::default();
+            let sink = got.clone();
+            s.on_write = Some(Rc::new(move |p: &str, b: &[u8]| sink.borrow_mut().push((p.to_string(), b.to_vec()))));
+            notify(s.write(Path::new("/S/Audio Files/a.wav"), vec![1]).ok().flatten());
+            notify(s.write(Path::new("/S/x.scraft.tmp"), b"{}".to_vec()).ok().flatten());
+            notify(s.rename(Path::new("/S/x.scraft.tmp"), Path::new("/S/x.scraft")).ok().flatten());
+            assert_eq!(got.borrow().clone(), vec![("/S/Audio Files/a.wav".to_string(), vec![1]), ("/S/x.scraft".to_string(), b"{}".to_vec())]);
+            assert!(s.exists(Path::new("/S/x.scraft")) && !s.exists(Path::new("/S/x.scraft.tmp")));
+            assert!(s.rename(Path::new("/missing.tmp"), Path::new("/m")).is_err());
+        }
+    }
+}
